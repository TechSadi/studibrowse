# Copy to .env at the repo root and fill in. Never commit .env.
# The server validates these at boot (apps/server/src/config/env.ts) and exits if one is missing or invalid.

# development | test | production
NODE_ENV=development

# Port the Express + Socket.IO server listens on. The Vite dev proxy expects 4000.
PORT=4000

# MongoDB connection string. Matches the docker-compose.yml service.
MONGODB_URI=mongodb://localhost:27017/studibrowse

# Origin of the web client, allowed by CORS and Socket.IO.
CLIENT_ORIGIN=http://localhost:5173

# Server log level: fatal | error | warn | info | debug | trace | silent. Defaults to info.
LOG_LEVEL=info

# Secret that signs access tokens (JWT, HS256). At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-bytes

# Access token lifetime in seconds. Defaults to 900 (15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in days ("keep me logged in"). Defaults to 30.
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt cost factor for password hashes. Defaults to 12; keep it at 12 or higher outside tests.
BCRYPT_COST=12

# Google sign-in: the OAuth client id from Google Cloud Console (APIs & Services > Credentials).
# Optional in development (POST /api/auth/google then answers 503); required in production.
GOOGLE_CLIENT_ID=

# The web app reuses GOOGLE_CLIENT_ID above (apps/web/vite.config.ts). Set this only to give the web app a
# different client id. With neither set, the Google button says sign-in is unavailable.
VITE_GOOGLE_CLIENT_ID=

# Password reset emails are sent through Resend in production and printed to the server log otherwise.
# Both are required in production. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=StudiBrowse <noreply@example.com>
