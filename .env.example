# Copy to .env at the repo root and fill in. Never commit .env.
# The server validates these at boot (apps/server/src/config/env.ts) and exits if one is missing or invalid.

# development | test | production
NODE_ENV=development

# Port the Express + Socket.IO server listens on. The Vite dev proxy expects 4000.
PORT=4000

# MongoDB connection string. Matches the docker-compose.yml service.
MONGODB_URI=mongodb://localhost:27017/studibrowse

# Origin of the web client (the Vercel URL in production), allowed by CORS and Socket.IO and used in reset links.
# Must be https in production.
CLIENT_ORIGIN=http://localhost:5173

# How many proxies sit in front of the API server, so per-IP rate limits see the visitor's address.
# 0 locally. In production REST arrives browser -> Vercel rewrite -> Render's proxy -> server, so use 2.
TRUST_PROXY=0

# The API origin the browser opens the Socket.IO connection to. Empty means the page's own origin (the Vite proxy
# in dev). In production, the Render origin, e.g. https://studibrowse-api.onrender.com, because Vercel can't proxy
# WebSockets. REST never uses it: it always goes to /api on the page's origin (the Vercel rewrite in production).
VITE_API_URL=

# Server log level: fatal | error | warn | info | debug | trace | silent. Defaults to info.
LOG_LEVEL=info

# Secret that signs access tokens (JWT, HS256). At least 32 characters; production refuses this example value.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-bytes

# Access token lifetime in seconds. Defaults to 900 (15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in days ("keep me logged in"). Defaults to 30.
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt cost factor for password hashes. Defaults to 12; keep it at 12 or higher outside tests.
BCRYPT_COST=12

# Google sign-in: the OAuth client id from Google Cloud Console (APIs & Services > Credentials).
# Optional in development (POST /api/auth/google then answers 503); required in production.
GOOGLE_CLIENT_ID=

# The web app reuses GOOGLE_CLIENT_ID above (apps/web/vite.config.ts). Set this only to give the web app a
# different client id. With neither set, the Google button says sign-in is unavailable.
VITE_GOOGLE_CLIENT_ID=

# Password reset emails are sent through Resend in production and printed to the server log otherwise.
# Both are required in production. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=StudiBrowse <noreply@example.com>

# Room file uploads (PDFs and images) go straight from the browser to Cloudinary. From the Cloudinary console
# (Settings > API Keys). All three are required in production; without them elsewhere, uploads are off and
# links still work. Turn on Settings > Security > "Allow delivery of PDF and ZIP files", or PDFs won't open.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Error tracking (Sentry). Blank turns it off; production logs a warning at boot without it.
# The API's DSN, from Sentry > the studibrowse-api project > Settings > Client Keys (DSN).
SENTRY_DSN=
# Optional. The release each event is tagged with. Defaults to the deployed commit (RENDER_GIT_COMMIT on Render).
SENTRY_RELEASE=

# The web app's DSN (the studibrowse-web project). A DSN is public: it only allows sending events.
VITE_SENTRY_DSN=
# Build-time only, for uploading the web app's source maps to Sentry. Without SENTRY_AUTH_TOKEN the build makes
# no source maps. Never prefix these with VITE_: the token is a secret.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=studibrowse-web
